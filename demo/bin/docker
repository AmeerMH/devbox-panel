#!/usr/bin/env bash
# Fake docker CLI for the demo — invented containers, no daemon involved.
# Limits live in a small state file so `docker update` from the UI is visible.
set -uo pipefail
STATE=${DEMO_DOCKER_STATE:-/tmp/devbox-panel-demo/docker-state.json}
mkdir -p "$(dirname "$STATE")"
[ -f "$STATE" ] || cat > "$STATE" <<'JSON'
{
  "demo-postgres": {"Memory": 2147483648, "MemorySwap": 4294967296, "MemoryReservation": 1073741824, "NanoCpus": 2000000000, "Restart": "unless-stopped", "Compose": "demo-infra"},
  "demo-redis":    {"Memory": 536870912,  "MemorySwap": 1073741824, "MemoryReservation": 0,          "NanoCpus": 500000000,  "Restart": "unless-stopped", "Compose": "demo-infra"},
  "demo-mongo":    {"Memory": 0,          "MemorySwap": 0,          "MemoryReservation": 0,          "NanoCpus": 0,          "Restart": "always",         "Compose": "demo-analytics"},
  "demo-search":   {"Memory": 4294967296, "MemorySwap": 8589934592, "MemoryReservation": 2147483648, "NanoCpus": 3000000000, "Restart": "always",         "Compose": "demo-analytics"},
  "demo-minio":    {"Memory": 0,          "MemorySwap": 0,          "MemoryReservation": 0,          "NanoCpus": 0,          "Restart": "no",             "Compose": "demo-infra"}
}
JSON

image_for() {
  case "$1" in
    demo-postgres) echo "pgvector/pgvector:pg16" ;;
    demo-redis)    echo "redis:7-alpine" ;;
    demo-mongo)    echo "mongo:7" ;;
    demo-search)   echo "opensearchproject/opensearch:2" ;;
    demo-minio)    echo "minio/minio:latest" ;;
    *)             echo "scratch" ;;
  esac
}

cmd=${1:-}
case "$cmd" in
  version) echo "27.3.1" ;;

  ps)
    cat <<'JSON'
{"ID":"a1b2c3d4e5f6","Names":"demo-postgres","Image":"pgvector/pgvector:pg16","State":"running","Status":"Up 12 days (healthy)","Ports":"127.0.0.1:5432->5432/tcp","CreatedAt":"2026-08-08 10:12:44 +0000 UTC","Labels":"com.docker.compose.project=demo-infra"}
{"ID":"b2c3d4e5f6a1","Names":"demo-redis","Image":"redis:7-alpine","State":"running","Status":"Up 12 days (healthy)","Ports":"127.0.0.1:6379->6379/tcp","CreatedAt":"2026-08-08 10:12:45 +0000 UTC","Labels":"com.docker.compose.project=demo-infra"}
{"ID":"c3d4e5f6a1b2","Names":"demo-mongo","Image":"mongo:7","State":"running","Status":"Up 5 days","Ports":"127.0.0.1:27017->27017/tcp","CreatedAt":"2026-08-15 08:03:11 +0000 UTC","Labels":"com.docker.compose.project=demo-analytics"}
{"ID":"d4e5f6a1b2c3","Names":"demo-search","Image":"opensearchproject/opensearch:2","State":"running","Status":"Up 5 days (unhealthy)","Ports":"127.0.0.1:9200->9200/tcp","CreatedAt":"2026-08-15 08:03:12 +0000 UTC","Labels":"com.docker.compose.project=demo-analytics"}
{"ID":"e5f6a1b2c3d4","Names":"demo-minio","Image":"minio/minio:latest","State":"exited","Status":"Exited (0) 3 days ago","Ports":"","CreatedAt":"2026-08-11 19:40:02 +0000 UTC","Labels":"com.docker.compose.project=demo-infra"}
JSON
    ;;

  stats)
    cat <<'JSON'
{"Name":"demo-postgres","CPUPerc":"0.42%","MemUsage":"1.18GiB / 2GiB","MemPerc":"59.1%","NetIO":"1.2GB / 890MB","BlockIO":"4.1GB / 12.7GB","PIDs":"14"}
{"Name":"demo-redis","CPUPerc":"0.11%","MemUsage":"318MiB / 512MiB","MemPerc":"62.1%","NetIO":"420MB / 380MB","BlockIO":"0B / 8.2MB","PIDs":"6"}
{"Name":"demo-mongo","CPUPerc":"0.28%","MemUsage":"1.4GiB / 47GiB","MemPerc":"2.98%","NetIO":"96MB / 71MB","BlockIO":"1.1GB / 3.4GB","PIDs":"33"}
{"Name":"demo-search","CPUPerc":"1.94%","MemUsage":"3.6GiB / 4GiB","MemPerc":"90.1%","NetIO":"12MB / 9MB","BlockIO":"620MB / 1.2GB","PIDs":"58"}
JSON
    ;;

  inspect)
    shift
    names=("$@")
    python3 - "$STATE" "${names[@]}" <<'PY'
import json, sys
state = json.load(open(sys.argv[1]))
images = {"demo-postgres":"pgvector/pgvector:pg16","demo-redis":"redis:7-alpine","demo-mongo":"mongo:7",
          "demo-search":"opensearchproject/opensearch:2","demo-minio":"minio/minio:latest"}
envs = {"demo-postgres":["POSTGRES_USER=demo","POSTGRES_DB=demo","POSTGRES_PASSWORD=demo"],
        "demo-redis":[], "demo-mongo":[], "demo-search":[], "demo-minio":[]}
out = []
for name in sys.argv[2:]:
    s = state.get(name, {})
    out.append({
        "Id": name, "Name": "/" + name,
        "State": {"Status": "exited" if name == "demo-minio" else "running",
                  "Health": {"Status": "healthy", "FailingStreak": 0}},
        "Config": {"Image": images.get(name, "scratch"), "Env": envs.get(name, []),
                   "Labels": {"com.docker.compose.project": s.get("Compose", "")} if s.get("Compose") else {}},
        "HostConfig": {"Memory": s.get("Memory", 0), "MemorySwap": s.get("MemorySwap", 0),
                       "MemoryReservation": s.get("MemoryReservation", 0), "NanoCpus": s.get("NanoCpus", 0),
                       "CpuShares": 0, "PidsLimit": 0,
                       "RestartPolicy": {"Name": s.get("Restart", "no"), "MaximumRetryCount": 0}},
        "NetworkSettings": {"Ports": {}}, "Mounts": [],
    })
print(json.dumps(out, indent=1))
PY
    ;;

  update)
    shift
    python3 - "$STATE" "$@" <<'PY'
import json, re, sys
state_path, args = sys.argv[1], sys.argv[2:]
name = args[-1]
state = json.load(open(state_path))
entry = state.setdefault(name, {})

def to_bytes(text):
    m = re.match(r'^(-?\d+(?:\.\d+)?)([kmgt]?)$', text.strip().lower())
    if not m: return 0
    mult = {"": 1, "k": 1024, "m": 1024**2, "g": 1024**3, "t": 1024**4}[m.group(2)]
    return int(float(m.group(1)) * mult)

i = 0
changed = []
while i < len(args) - 1:
    flag, value = args[i], args[i + 1] if i + 1 < len(args) else ""
    if flag == "--memory": entry["Memory"] = to_bytes(value); changed.append(f"memory={value}"); i += 2
    elif flag == "--memory-swap": entry["MemorySwap"] = to_bytes(value); i += 2
    elif flag == "--memory-reservation": entry["MemoryReservation"] = to_bytes(value); changed.append(f"reservation={value}"); i += 2
    elif flag == "--cpus": entry["NanoCpus"] = int(float(value) * 1e9); changed.append(f"cpus={value}"); i += 2
    elif flag == "--restart": entry["Restart"] = value; changed.append(f"restart={value}"); i += 2
    else: i += 1

json.dump(state, open(state_path, "w"), indent=1)
print(name)
print("updated: " + ", ".join(changed), file=sys.stderr)
PY
    ;;

  exec)
    shift
    # Skip -u/-e options to find the container name and the command.
    while [ $# -gt 0 ]; do
      case "$1" in
        -u|-e) shift 2 ;;
        *) break ;;
      esac
    done
    container=${1:-}; shift || true
    tool=${1:-}; shift || true
    case "$tool" in
      psql)
        query=""
        while [ $# -gt 0 ]; do [ "$1" = "-tAc" ] && { query=${2:-}; break; }; shift; done
        case "$query" in
          *server_version*) echo "16.4" ;;
          *pg_settings*)
            cat <<'PGSET'
shared_buffers|16384|8kB|configuration file
effective_cache_size|262144|8kB|default
work_mem|4096|kB|default
maintenance_work_mem|65536|kB|default
autovacuum_work_mem|-1|kB|default
max_connections|100||configuration file
temp_buffers|1024|8kB|default
wal_buffers|512|8kB|default
max_wal_size|1024|MB|default
checkpoint_completion_target|0.9||default
random_page_cost|4||default
effective_io_concurrency|1||default
PGSET
            ;;
          *ALTER\ SYSTEM*) echo "ALTER SYSTEM" ;;
          *pg_reload_conf*) echo "t" ;;
          *) echo "" ;;
        esac
        ;;
      redis-cli)
        sub=${1:-}; shift || true
        case "$sub" in
          INFO) echo "redis_version:7.4.1" ;;
          CONFIG)
            action=${1:-}; key=${2:-}; value=${3:-}
            case "$action" in
              GET)
                echo "$key"
                case "$key" in
                  maxmemory) echo "402653184" ;;
                  maxmemory-policy) echo "allkeys-lru" ;;
                  appendonly) echo "no" ;;
                  maxclients) echo "10000" ;;
                  timeout) echo "0" ;;
                  *) echo "" ;;
                esac
                ;;
              SET) echo "OK" ;;
              REWRITE) echo "OK" ;;
            esac
            ;;
        esac
        ;;
      mongosh|mongo)
        expr="$*"
        case "$expr" in
          *quit*) exit 0 ;;
          *db.version*) echo "7.0.14" ;;
          *serverStatus*) echo '{"cache":1073741824,"sort":33554432}' ;;
          *setParameter*) echo '{"ok":1}' ;;
          *) echo "{}" ;;
        esac
        ;;
      *) echo "demo exec: $tool" ;;
    esac
    ;;

  logs)
    name=${*: -1}
    echo "2026-08-20T21:14:02.104Z LOG:  database system is ready to accept connections"
    i=0
    while true; do
      i=$((i+1))
      echo "2026-08-20T21:$((14 + i % 45)):$((i % 60)).${i}Z LOG:  statement: SELECT id, title FROM products WHERE store_id = \$1 LIMIT 24  [$name]"
      sleep 2
    done
    ;;

  start|stop|restart) echo "${2:-container}"; sleep 1 ;;
  *) echo "docker: demo stub ($cmd)" ;;
esac
