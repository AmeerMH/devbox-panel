# devbox-panel — install as /etc/sudoers.d/devbox-panel (mode 0440, root:root).
#
# Grants two helper scripts, both of which validate their own arguments:
#   devbox-panel-nginx    read vhost files, tail logs, `nginx -t`, reload
#   devbox-panel-dbadmin  systemd memory/CPU limits and Postgres settings for
#                         databases that run as HOST SERVICES (containerised ones
#                         never need root — they go through `docker exec`)
# Neither takes a free-form path, shell argument or SQL string.
#
#   install -m 0755 -o root -g root deploy/devbox-panel-nginx /usr/local/bin/devbox-panel-nginx
#   install -m 0755 -o root -g root deploy/devbox-panel-dbadmin /usr/local/bin/devbox-panel-dbadmin
#   install -m 0440 -o root -g root deploy/sudoers.devbox-panel /etc/sudoers.d/devbox-panel
#   visudo -c
#
# The two systemctl lines are only needed when the panel runs as a systemd service
# and you want `make deploy` / the self-update target to work from the UI. They name
# the unit explicitly, so they cannot restart anything else.
#
# Replace `deploy` if the panel runs as a different user.
deploy ALL=(root) NOPASSWD: /usr/local/bin/devbox-panel-nginx
deploy ALL=(root) NOPASSWD: /usr/local/bin/devbox-panel-dbadmin
deploy ALL=(root) NOPASSWD: /usr/bin/systemctl restart devbox-panel
deploy ALL=(root) NOPASSWD: /usr/bin/systemctl status devbox-panel
