# Copy to .env (never commit it) and fill in.
#
#   npm run gen-secret        -> PANEL_SESSION_SECRET
#   npm run hash-password     -> PANEL_PASSWORD_HASH

# Login password, stored as a scrypt hash. Generate with `npm run hash-password`.
PANEL_PASSWORD_HASH=

# HMAC key for the session cookie. 32+ random bytes. Rotating it logs everyone out.
PANEL_SESSION_SECRET=

# Optional overrides (defaults come from config/panel.config.json)
# PANEL_CONFIG=/etc/devbox-panel/panel.config.json
# PANEL_PORT=7070
# PANEL_HOST=127.0.0.1
# Set to 1 only when nginx terminates TLS in front of the panel (sets Secure cookies,
# and trusts X-Forwarded-For for the login rate limiter).
# PANEL_BEHIND_PROXY=1
# Session lifetime in hours (default 12)
# PANEL_SESSION_HOURS=12
